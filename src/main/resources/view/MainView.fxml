<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartcampus.controller.MainController"
            prefWidth="1200" prefHeight="750" styleClass="main-root">
    <left>
        <VBox styleClass="sidebar" prefWidth="220" minWidth="220">
            <padding>
                <Insets top="20" right="12" bottom="20" left="12"/>
            </padding>
            <Label text="Smart Campus" styleClass="sidebar-title"/>
            <Separator/>
            <Button fx:id="dashboardBtn" text="Dashboard" onAction="#showDashboard" styleClass="nav-button" maxWidth="Infinity"/>
            <Button fx:id="studentsBtn" text="Students" onAction="#showStudents" styleClass="nav-button" maxWidth="Infinity"/>
            <Button fx:id="coursesBtn" text="Courses" onAction="#showCourses" styleClass="nav-button" maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Separator/>
            <ToggleButton fx:id="themeToggle" text="Dark Mode" onAction="#toggleTheme" maxWidth="Infinity"/>
            <Button fx:id="logoutBtn" text="Logout" onAction="#handleLogout" styleClass="nav-button-logout" maxWidth="Infinity"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentPane" styleClass="content-pane"/>
    </center>
</BorderPane>
