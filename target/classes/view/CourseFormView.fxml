<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartcampus.controller.CourseController" spacing="12" prefWidth="400">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label fx:id="courseFormTitle" text="Add Course" styleClass="section-label"/>
    <Label text="Title *"/>
    <TextField fx:id="formTitle" promptText="Course title"/>
    <Label text="Teacher"/>
    <ComboBox fx:id="formTeacher" prefWidth="Infinity" promptText="Select teacher (optional)"/>
    <Label fx:id="courseFormError" styleClass="error-label" visible="false" managed="false"/>
    <HBox spacing="12">
        <Button text="Save" onAction="#saveCourseForm" defaultButton="true"/>
        <Button text="Cancel" onAction="#cancelCourseForm" cancelButton="true"/>
    </HBox>
</VBox>
